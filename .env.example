# Copie este arquivo para ".env" e preencha com os valores reais.
# O ".env" nunca é commitado (está no .gitignore).
#
# Onde conseguir cada valor: Seller Central > Apps e Serviços > Desenvolver
# Apps > seu app SP-API. Os refresh tokens vêm da autorização do app
# contra cada conta Vendor (fluxo "Authorize" feito uma vez por conta).

# Credenciais do app LWA (Login With Amazon) cadastrado na Amazon.
# Compartilhadas por todas as contas.
SP_API_LWA_CLIENT_ID=
SP_API_LWA_CLIENT_SECRET=

# ID do marketplace (Brasil = A2Q3Y263D00KWC, é o padrão se omitido)
SP_API_MARKETPLACE_ID=A2Q3Y263D00KWC

# Região do endpoint SP-API: NA, EU ou FE (padrão: NA)
SP_API_REGION=NA

# Um refresh token por conta. A chave usada nos JSONs do dashboard
# está entre parênteses.
SP_API_REFRESH_TOKEN_ALFAJF=       # alfa_jf
SP_API_REFRESH_TOKEN_BLIDSHOP=     # blidshop
SP_API_REFRESH_TOKEN_PETCLEAN=     # conta3 (Petclean BR)
SP_API_REFRESH_TOKEN_OZITP=        # ozitp
SP_API_REFRESH_TOKEN_JOLITEX=      # jolitex
SP_API_REFRESH_TOKEN_BALBOA=       # balboa
SP_API_REFRESH_TOKEN_RIOMASTER=    # riomaster
