# Copie este arquivo para ".env" e preencha com os valores reais.
# O ".env" nunca é commitado (está no .gitignore).
#
# Onde conseguir cada valor: Seller Central > Apps e Serviços > Desenvolver
# Apps > seu app SP-API. O refresh token vem da autorização do app
# contra a conta Vendor (fluxo "Authorize" feito uma vez).

# Credenciais do app LWA (Login With Amazon) cadastrado na Amazon
SPAPI_LWA_CLIENT_ID=
SPAPI_LWA_CLIENT_SECRET=

# Refresh token gerado ao autorizar o app na conta Vendor
SPAPI_REFRESH_TOKEN=

# ID do marketplace (Brasil = A2Q3Y263D00KWC)
SPAPI_MARKETPLACE_ID=A2Q3Y263D00KWC

# Região do endpoint SP-API: NA, EU ou FE
SPAPI_REGION=NA
